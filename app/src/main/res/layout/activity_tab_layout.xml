<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ViewPager chiếm phần còn lại bên trên -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- TabLayout nằm dưới cùng -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingVertical="20dp"
            app:tabIndicatorColor="#92A3FD"
            app:tabTextColor="#ADA4A5"
            app:tabSelectedTextColor="#92A3FD"
            app:tabMode="fixed"
            app:tabGravity="fill" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="Open chat"
        app:srcCompat="@drawable/bot_icon_big"
        app:tint="@android:color/white"
        app:backgroundTint="@color/primary"
        app:maxImageSize="36dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
