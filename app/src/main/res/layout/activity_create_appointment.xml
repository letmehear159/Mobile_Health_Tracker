<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo lịch hẹn mới"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp" />

        <!-- Doctor Name -->
        <EditText
            android:id="@+id/etDoctorName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Tên bác sĩ"
            android:background="@drawable/edit_text_bg"
            android:paddingStart="12dp"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:inputType="textPersonName" />

        <!-- Date -->
        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Ngày (vd: 2025-05-25)"
            android:background="@drawable/edit_text_bg"
            android:paddingStart="12dp"
            android:inputType="date"
            android:textColorHint="#888888" />

        <!-- Time -->
        <EditText
            android:id="@+id/etTime"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Giờ (vd: 14:30)"
            android:background="@drawable/edit_text_bg"
            android:paddingStart="12dp"
            android:inputType="time"
            android:textColorHint="#888888" />

        <!-- Location -->
        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Địa điểm"
            android:background="@drawable/edit_text_bg"
            android:paddingStart="12dp"
            android:inputType="textPostalAddress"
            android:textColorHint="#888888" />

        <!-- Ticket Code -->
        <EditText
            android:id="@+id/etTicket"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Mã vé"
            android:background="@drawable/edit_text_bg"
            android:paddingStart="12dp"
            android:inputType="text"
            android:textColorHint="#888888" />

        <!-- Create Button -->
        <Button
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Tạo lịch hẹn"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_gradient_bg" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Hủy"
            android:textColor="#000000"
            android:background="@drawable/btn_secondary_bg" />

    </LinearLayout>
</ScrollView>
